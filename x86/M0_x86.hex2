#
# M0-pe32: the Windows (PE32/i386) port of stage0's M0 macro assembler.
#
# M0 reads an M1 source file and writes hex2.  It is the first link that reads a
# language rather than an encoding: a name can stand for a sequence of bytes.
#
#   M0 INPUT OUTPUT
#     argv[1]        an M1 source file
#     argv[2]        a path, created or truncated for writing
#
#   DEFINE name body   name means body from here on
#   'ABCD'             hex, passed through as written
#   "text"             text, emitted as two hex digits a character and a 00
#   !5 @577 %0x100000  an immediate, one/two/four bytes, little-endian
#   # or ;             a comment, to end of line
#   anything else      passed through, which is what carries hex2's own syntax
#
# A carriage return separates tokens here as well as a newline, which upstream
# does not do: an M1 file written on Windows would otherwise carry a stray
# into every token at the end of a line.
#
# Tokens become a linked list, and the work is a sequence of passes over it.
# Nothing is ever freed: malloc hands out the zero-filled memory past the end of
# the file, so the passes can be as careless with it as upstream's are.
#
# This file carries neither a PE header nor the Windows plumbing every program
# here needs.  catm puts both in front of it:
#
#   catm M0.hex2 PE32-i386.hex2 ntdll-i386.hex2 M0_x86.hex2
#   hex2 M0.hex2 M0
#
# which is upstream's shape, with the PE32 header standing in for the ELF one and
# ntdll-i386.hex2 standing in for the syscalls upstream can simply make.

# malloc(eax = size) -> eax = pointer.
# A bump allocator over the memory past the end of the file.  The loader zeroed
# it, so this is calloc as well, which is what every caller assumes.  Nothing is
# ever freed; upstream calls brk twice for the same effect.
:malloc
	53                          ; push ebx
	8B 1D &malloc_ptr           ; mov ebx, [malloc_ptr]
	01 05 &malloc_ptr           ; add [malloc_ptr], eax
	89 D8                       ; mov eax, ebx                # the block starts where the cursor was
	5B                          ; pop ebx
	C3                          ; ret

# In_Set(eax = char, ebx = set) -> 1 if the character is in the NUL-terminated set.
:In_Set
	53                          ; push ebx
	51                          ; push ecx

:In_Set.loop
	8A 0B                       ; mov cl, [ebx]
	0F B6 C9                    ; movzx ecx, cl
	85 C9                       ; test ecx, ecx
	0F 84 %In_Set.false         ; je In_Set.false             # the NUL ends the set
	39 C8                       ; cmp eax, ecx
	0F 84 %In_Set.true          ; je In_Set.true
	43                          ; inc ebx
	E9 %In_Set.loop             ; jmp In_Set.loop

:In_Set.true
	B8 01 00 00 00              ; mov eax, 0x1                # mov eax, 1
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

:In_Set.false
	31 C0                       ; xor eax, eax
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# match(eax, ebx) -> 0 if the two strings are equal, 1 if not.
:match
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C2                       ; mov edx, eax                # walk both strings together

:match.loop
	8A 0A                       ; mov cl, [edx]
	0F B6 C9                    ; movzx ecx, cl
	8A 03                       ; mov al, [ebx]
	0F B6 C0                    ; movzx eax, al
	39 C1                       ; cmp ecx, eax
	0F 85 %match.false          ; jne match.false
	85 C9                       ; test ecx, ecx
	0F 84 %match.true           ; je match.true               # both hit NUL together
	42                          ; inc edx
	43                          ; inc ebx
	E9 %match.loop              ; jmp match.loop

:match.true
	31 C0                       ; xor eax, eax                # 0 means equal, as upstream returns it
	E9 %match.done              ; jmp match.done

:match.false
	B8 01 00 00 00              ; mov eax, 0x1                # mov eax, 1

:match.done
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# string_length(eax) -> the number of bytes before the NUL.
:string_length
	53                          ; push ebx
	51                          ; push ecx
	89 C3                       ; mov ebx, eax
	31 C9                       ; xor ecx, ecx

:string_length.loop
	8A 04 0B                    ; mov al, [ebx+ecx]
	0F B6 C0                    ; movzx eax, al
	85 C0                       ; test eax, eax
	0F 84 %string_length.done   ; je string_length.done
	41                          ; inc ecx
	E9 %string_length.loop      ; jmp string_length.loop

:string_length.done
	89 C8                       ; mov eax, ecx
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# hex32l/hex16l/hex8(eax = value, ebx = destination): write the value as hex
# digits and advance ebx past them.  Each falls into the next, and each half is
# written low part first, so a 32-bit value comes out in little-endian byte
# order: 0x00100000 becomes 00001000.
:hex32l
	50                          ; push eax                    # protect the top half
	E8 %hex16l                  ; call hex16l
	58                          ; pop eax
	C1 E8 10                    ; shr eax, 16                 # the low half went out first, so this is little-endian

:hex16l
	50                          ; push eax
	E8 %hex8                    ; call hex8
	58                          ; pop eax
	C1 E8 08                    ; shr eax, 8

:hex8
	50                          ; push eax
	C1 E8 04                    ; shr eax, 4                  # high nibble first
	E8 %hex4                    ; call hex4
	58                          ; pop eax

:hex4
	83 E0 0F                    ; and eax, 0xf
	04 30                       ; add al, '0'
	3C 39                       ; cmp al, '9'
	0F 86 %hex1                 ; jbe hex1
	04 07                       ; add al, 7                   # shift into 'A'-'F'

:hex1
	88 03                       ; mov [ebx], al
	83 C3 01                    ; add ebx, 1
	C3                          ; ret

# numerate_string(eax = string) -> its value.
# "0x" selects hex and anything else is decimal, with a leading '-' to negate.
# The 0x test comes first and looks at S[1], so a negative hex number is not a
# thing: "-0x10" takes the decimal path and fails on the 'x'.  Hex digits are
# upper case only, for the same reason -- 'a' lands past 15 and fails.  A string
# that is not a number returns 0, which the caller tells from a real zero by
# looking at the first digit.
#
# Upstream leaves the negation flag in EDI uninitialised, and gets away with it
# because EDI holds its malloc pointer and is never 1.  This zeroes it, which is
# the same behaviour for every input and no behaviour for none.
:numerate_string
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	57                          ; push edi
	89 C3                       ; mov ebx, eax                # S
	31 C0                       ; xor eax, eax                # VALUE = 0
	31 FF                       ; xor edi, edi                # NEGATIVE = 0  -- upstream never initialises this; see the note
	8A 4B 01                    ; mov cl, [ebx+1]
	0F B6 C9                    ; movzx ecx, cl               # S[1]
	83 F9 78                    ; cmp ecx, 'x'
	0F 84 %numerate_string.hex  ; je numerate_string.hex      # tested before the sign, so 0x is only ever positive
	B9 00 00 00 00              ; mov ecx, 0
	8A 0B                       ; mov cl, [ebx]
	0F B6 C9                    ; movzx ecx, cl               # S[0]
	83 F9 2D                    ; cmp ecx, '-'
	0F 85 %numerate_string.dec  ; jne numerate_string.dec
	BF 01 00 00 00              ; mov edi, 0x1                # mov edi, 1
	83 C3 01                    ; add ebx, 1

:numerate_string.dec
	8A 0B                       ; mov cl, [ebx]
	0F B6 C9                    ; movzx ecx, cl
	83 F9 00                    ; cmp ecx, 0
	0F 84 %numerate_string.decdone ; je numerate_string.decdone
	6B C0 0A                    ; imul eax, 10
	83 E9 30                    ; sub ecx, '0'
	83 F9 09                    ; cmp ecx, 9
	0F 8F %numerate_string.fail ; jg numerate_string.fail
	83 F9 00                    ; cmp ecx, 0
	0F 8C %numerate_string.fail ; jl numerate_string.fail
	01 C8                       ; add eax, ecx
	83 C3 01                    ; add ebx, 1
	E9 %numerate_string.dec     ; jmp numerate_string.dec

:numerate_string.decdone
	83 FF 01                    ; cmp edi, 1
	0F 85 %numerate_string.done ; jne numerate_string.done
	6B C0 FF                    ; imul eax, -1
	E9 %numerate_string.done    ; jmp numerate_string.done

:numerate_string.hex
	83 C3 02                    ; add ebx, 2                  # step over the 0x

:numerate_string.hexloop
	8A 0B                       ; mov cl, [ebx]
	0F B6 C9                    ; movzx ecx, cl
	83 F9 00                    ; cmp ecx, 0
	0F 84 %numerate_string.done ; je numerate_string.done
	C1 E0 04                    ; shl eax, 4
	83 E9 30                    ; sub ecx, '0'
	83 F9 0A                    ; cmp ecx, 10
	0F 8C %numerate_string.digit ; jl numerate_string.digit
	83 E9 07                    ; sub ecx, 7                  # push A-F into range; lower case does not survive this

:numerate_string.digit
	83 F9 0F                    ; cmp ecx, 15
	0F 8F %numerate_string.fail ; jg numerate_string.fail
	83 F9 00                    ; cmp ecx, 0
	0F 8C %numerate_string.fail ; jl numerate_string.fail
	01 C8                       ; add eax, ecx
	83 C3 01                    ; add ebx, 1
	E9 %numerate_string.hexloop ; jmp numerate_string.hexloop

:numerate_string.fail
	31 C0                       ; xor eax, eax                # not a number: return zero and let the caller decide

:numerate_string.done
	5F                          ; pop edi
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# express_number(eax = value, ebx = prefix) -> a fresh hex string.
# The prefix chooses the width: '%' four bytes, '@' two, anything else one.  That
# is how an M1 source says how wide an immediate should be.
:express_number
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 D9                       ; mov ecx, ebx                # CH
	89 C3                       ; mov ebx, eax                # protect VALUE
	83 F9 25                    ; cmp ecx, '%'
	0F 85 %express_number.at    ; jne express_number.at
	B8 09 00 00 00              ; mov eax, 0x9                # mov eax, 9  -- eight digits and a NUL
	E8 %malloc                  ; call malloc
	93                          ; xchg eax, ebx               # eax = VALUE, ebx = S
	53                          ; push ebx                    # protect S; the hex routines advance it
	E8 %hex32l                  ; call hex32l
	E9 %express_number.done     ; jmp express_number.done

:express_number.at
	83 F9 40                    ; cmp ecx, '@'
	0F 85 %express_number.one   ; jne express_number.one
	B8 05 00 00 00              ; mov eax, 0x5                # mov eax, 5
	E8 %malloc                  ; call malloc
	93                          ; xchg eax, ebx
	53                          ; push ebx
	E8 %hex16l                  ; call hex16l
	E9 %express_number.done     ; jmp express_number.done

:express_number.one
	B8 03 00 00 00              ; mov eax, 0x3                # mov eax, 3
	E8 %malloc                  ; call malloc
	93                          ; xchg eax, ebx
	53                          ; push ebx
	E8 %hex8                    ; call hex8

:express_number.done
	58                          ; pop eax                     # S
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# Store_Atom(ecx = first character) -> a fresh string.
# Reads to the next space, tab or newline, consuming it.
# The string's start is held in esi, not edx: every read goes through NtReadFile,
# and the Windows calling convention leaves eax, ecx and edx to the callee.
:Store_Atom
	53                          ; push ebx
	56                          ; push esi
	57                          ; push edi
	B8 00 01 00 00              ; mov eax, 0x100              # mov eax, 256
	E8 %malloc                  ; call malloc
	89 C6                       ; mov esi, eax                # keep the start to return; esi survives a call, edx does not
	89 C7                       ; mov edi, eax                # cursor

:Store_Atom.loop
	89 C8                       ; mov eax, ecx
	88 07                       ; mov [edi], al
	47                          ; inc edi
	E8 %fgetc                   ; call fgetc
	89 C1                       ; mov ecx, eax
	83 F8 FC                    ; cmp eax, -4
	0F 84 %Store_Atom.done      ; je Store_Atom.done          # end of file ends the atom too
	BB &terminators             ; mov ebx, terminators
	E8 %In_Set                  ; call In_Set
	85 C0                       ; test eax, eax
	0F 84 %Store_Atom.loop      ; je Store_Atom.loop

:Store_Atom.done
	89 F0                       ; mov eax, esi
	5F                          ; pop edi
	5E                          ; pop esi
	5B                          ; pop ebx
	C3                          ; ret

# Store_String(ecx = quote) -> a fresh string.
# Reads to the matching quote.  The opening quote is kept as the first character,
# which is how Process_String later tells '...' from "..." ; the closing one is
# dropped.
:Store_String
	53                          ; push ebx
	56                          ; push esi
	57                          ; push edi
	51                          ; push ecx                    # the quote is also the terminator
	B8 00 01 00 00              ; mov eax, 0x100              # mov eax, 256
	E8 %malloc                  ; call malloc
	89 C6                       ; mov esi, eax
	89 C7                       ; mov edi, eax
	5B                          ; pop ebx                     # ebx = the quote character

:Store_String.loop
	89 C8                       ; mov eax, ecx
	88 07                       ; mov [edi], al
	47                          ; inc edi
	E8 %fgetc                   ; call fgetc
	89 C1                       ; mov ecx, eax
	83 F8 FC                    ; cmp eax, -4
	0F 84 %Store_String.done    ; je Store_String.done
	39 D8                       ; cmp eax, ebx
	0F 85 %Store_String.loop    ; jne Store_String.loop

:Store_String.done
	89 F0                       ; mov eax, esi                # the opening quote is kept, the closing one is not
	5F                          ; pop edi
	5E                          ; pop esi
	5B                          ; pop ebx
	C3                          ; ret

# Tokenize_Line(): read one token and put it on the front of the list.
# '#' and ';' begin a comment that runs to end of line.  The list is built
# backwards and reversed once the input is exhausted, which costs one pass and
# saves walking to the end for every token.
:Tokenize_Line

:Tokenize_Line.restart
	E8 %fgetc                   ; call fgetc
	A3 &tok_c                   ; mov [tok_c], eax
	83 F8 FC                    ; cmp eax, -4
	0F 84 %Tokenize_Line.eof    ; je Tokenize_Line.eof
	BB &comments                ; mov ebx, comments
	E8 %In_Set                  ; call In_Set
	85 C0                       ; test eax, eax
	0F 85 %Tokenize_Line.comment ; jne Tokenize_Line.comment
	A1 &tok_c                   ; mov eax, [tok_c]
	BB &terminators             ; mov ebx, terminators
	E8 %In_Set                  ; call In_Set
	85 C0                       ; test eax, eax
	0F 85 %Tokenize_Line.restart ; jne Tokenize_Line.restart   # whitespace between tokens
	B8 20 00 00 00              ; mov eax, 0x20               # mov eax, 32
	E8 %malloc                  ; call malloc
	A3 &tok_p                   ; mov [tok_p], eax
	8B 1D &head                 ; mov ebx, [head]
	89 18                       ; mov [eax], ebx              # p->NEXT = head; the list is built backwards
	A3 &head                    ; mov [head], eax
	A1 &tok_c                   ; mov eax, [tok_c]
	BB &string_char             ; mov ebx, string_char
	E8 %In_Set                  ; call In_Set
	85 C0                       ; test eax, eax
	0F 85 %Tokenize_Line.string ; jne Tokenize_Line.string
	8B 0D &tok_c                ; mov ecx, [tok_c]
	E8 %Store_Atom              ; call Store_Atom
	8B 1D &tok_p                ; mov ebx, [tok_p]
	89 43 10                    ; mov [ebx+16], eax           # p->TEXT
	C3                          ; ret

:Tokenize_Line.string
	8B 0D &tok_c                ; mov ecx, [tok_c]
	E8 %Store_String            ; call Store_String
	8B 1D &tok_p                ; mov ebx, [tok_p]
	89 43 10                    ; mov [ebx+16], eax           # p->TEXT
	C7 43 08 02 00 00 00        ; mov dword [ebx+8], 2        # p->TYPE = STRING
	C3                          ; ret

:Tokenize_Line.comment
	E8 %fgetc                   ; call fgetc
	83 F8 FC                    ; cmp eax, -4
	0F 84 %Tokenize_Line.eof    ; je Tokenize_Line.eof
	83 F8 0A                    ; cmp eax, 10
	0F 85 %Tokenize_Line.comment ; jne Tokenize_Line.comment
	E9 %Tokenize_Line.restart   ; jmp Tokenize_Line.restart

:Tokenize_Line.eof
	C7 05 &eof_flag 01 00 00 00 ; mov dword [eof_flag], 0x1   # mov dword [eof_flag], 1
	C3                          ; ret

# Reverse_List(eax = list) -> the same list, reversed.
:Reverse_List
	53                          ; push ebx
	51                          ; push ecx
	31 DB                       ; xor ebx, ebx                # prev = NULL

:Reverse_List.loop
	85 C0                       ; test eax, eax
	0F 84 %Reverse_List.done    ; je Reverse_List.done
	8B 08                       ; mov ecx, [eax]              # next
	89 18                       ; mov [eax], ebx              # cur->NEXT = prev
	89 C3                       ; mov ebx, eax
	89 C8                       ; mov eax, ecx
	E9 %Reverse_List.loop       ; jmp Reverse_List.loop

:Reverse_List.done
	89 D8                       ; mov eax, ebx
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# Identify_Macros(eax = list): find DEFINE.
# A DEFINE token takes over the two tokens after it: it keeps the name as its
# TEXT and the expansion as its EXPRESSION, and unlinks both.  It stays in the
# list as a MACRO so Line_Macro can find it, and Print_Hex skips it.
:Identify_Macros
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C2                       ; mov edx, eax                # I = HEAD

:Identify_Macros.loop
	8B 42 10                    ; mov eax, [edx+16]           # I->TEXT
	BB &M0_data                 ; mov ebx, DEFINE_str
	E8 %match                   ; call match
	85 C0                       ; test eax, eax
	0F 85 %Identify_Macros.next ; jne Identify_Macros.next
	C7 42 08 01 00 00 00        ; mov dword [edx+8], 1        # I->TYPE = MACRO
	8B 02                       ; mov eax, [edx]              # I->NEXT, the name
	8B 48 10                    ; mov ecx, [eax+16]
	89 4A 10                    ; mov [edx+16], ecx           # I->TEXT = name
	8B 18                       ; mov ebx, [eax]              # the expansion token
	8B 4B 10                    ; mov ecx, [ebx+16]
	8B 43 08                    ; mov eax, [ebx+8]            # its TYPE
	83 F8 02                    ; cmp eax, 2
	0F 85 %Identify_Macros.plain ; jne Identify_Macros.plain
	41                          ; inc ecx                     # a string expansion starts after the quote

:Identify_Macros.plain
	89 4A 18                    ; mov [edx+24], ecx           # I->EXPRESSION
	8B 03                       ; mov eax, [ebx]
	89 02                       ; mov [edx], eax              # I->NEXT skips the two tokens just consumed

:Identify_Macros.next
	8B 12                       ; mov edx, [edx]
	85 D2                       ; test edx, edx
	0F 85 %Identify_Macros.loop ; jne Identify_Macros.loop
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# Set_Expression(eax = list, ebx = name, ecx = expansion):
# give every later token with that name this expansion.  Macros are left alone,
# so a definition cannot rewrite another definition's name.
:Set_Expression
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	56                          ; push esi
	89 C2                       ; mov edx, eax                # I
	89 CE                       ; mov esi, ecx                # EXP

:Set_Expression.loop
	8B 42 08                    ; mov eax, [edx+8]
	83 F8 01                    ; cmp eax, 1
	0F 84 %Set_Expression.next  ; je Set_Expression.next      # leave macros alone
	8B 42 10                    ; mov eax, [edx+16]
	E8 %match                   ; call match
	85 C0                       ; test eax, eax
	0F 85 %Set_Expression.next  ; jne Set_Expression.next
	89 72 18                    ; mov [edx+24], esi           # I->EXPRESSION = EXP

:Set_Expression.next
	8B 12                       ; mov edx, [edx]
	85 D2                       ; test edx, edx
	0F 85 %Set_Expression.loop  ; jne Set_Expression.loop
	5E                          ; pop esi
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# Line_Macro(eax = list): apply each macro to everything after it.
:Line_Macro
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C2                       ; mov edx, eax

:Line_Macro.loop
	8B 42 08                    ; mov eax, [edx+8]
	83 F8 01                    ; cmp eax, 1
	0F 85 %Line_Macro.next      ; jne Line_Macro.next
	8B 02                       ; mov eax, [edx]
	85 C0                       ; test eax, eax
	0F 84 %Line_Macro.next      ; je Line_Macro.next          # nothing follows to substitute into
	8B 5A 10                    ; mov ebx, [edx+16]           # the macro name
	8B 4A 18                    ; mov ecx, [edx+24]           # its expansion
	E8 %Set_Expression          ; call Set_Expression

:Line_Macro.next
	8B 12                       ; mov edx, [edx]
	85 D2                       ; test edx, edx
	0F 85 %Line_Macro.loop      ; jne Line_Macro.loop
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# Process_String(eax = list): turn a quoted token into hex.
# '...' is already hex and passes through as written.  "..." is text, and becomes
# two hex digits per character plus a 00 terminator.
:Process_String
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C1                       ; mov ecx, eax                # I

:Process_String.loop
	8B 41 08                    ; mov eax, [ecx+8]
	83 F8 02                    ; cmp eax, 2
	0F 85 %Process_String.next  ; jne Process_String.next
	8B 59 10                    ; mov ebx, [ecx+16]           # I->TEXT
	8A 03                       ; mov al, [ebx]
	0F B6 C0                    ; movzx eax, al
	83 F8 27                    ; cmp eax, 0x27
	0F 85 %Process_String.raw   ; jne Process_String.raw
	83 C3 01                    ; add ebx, 1
	89 59 18                    ; mov [ecx+24], ebx           # '...' passes through as written
	E9 %Process_String.next     ; jmp Process_String.next

:Process_String.raw
	89 D8                       ; mov eax, ebx
	E8 %string_length           ; call string_length
	C1 E8 02                    ; shr eax, 2
	83 C0 01                    ; add eax, 1
	C1 E0 03                    ; shl eax, 3                  # room enough for two digits a character
	E8 %malloc                  ; call malloc
	89 DA                       ; mov edx, ebx
	83 C2 01                    ; add edx, 1                  # S = I->TEXT + 1, past the quote
	89 41 18                    ; mov [ecx+24], eax
	89 C3                       ; mov ebx, eax                # the hex cursor

:Process_String.rawloop
	8A 02                       ; mov al, [edx]
	0F B6 C0                    ; movzx eax, al
	83 C2 01                    ; add edx, 1
	3C 00                       ; cmp al, 0
	9C                          ; pushf                       # the NUL is emitted too, then ends the loop
	E8 %hex8                    ; call hex8
	9D                          ; popf
	0F 85 %Process_String.rawloop ; jne Process_String.rawloop

:Process_String.next
	8B 09                       ; mov ecx, [ecx]
	85 C9                       ; test ecx, ecx
	0F 85 %Process_String.loop  ; jne Process_String.loop
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# Eval_Immediates(eax = list): turn a prefixed number into hex.
# Only tokens that no macro claimed are considered.
:Eval_Immediates
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C2                       ; mov edx, eax

:Eval_Immediates.loop
	8B 42 08                    ; mov eax, [edx+8]
	83 F8 01                    ; cmp eax, 1
	0F 84 %Eval_Immediates.next ; je Eval_Immediates.next
	8B 42 18                    ; mov eax, [edx+24]
	85 C0                       ; test eax, eax
	0F 85 %Eval_Immediates.next ; jne Eval_Immediates.next    # already has an expression
	8B 42 10                    ; mov eax, [edx+16]
	8A 18                       ; mov bl, [eax]
	0F B6 DB                    ; movzx ebx, bl               # TEXT[0], the width prefix
	83 C0 01                    ; add eax, 1
	8A 08                       ; mov cl, [eax]
	0F B6 C9                    ; movzx ecx, cl               # TEXT[1]
	E8 %numerate_string         ; call numerate_string
	85 C0                       ; test eax, eax
	0F 85 %Eval_Immediates.value ; jne Eval_Immediates.value
	83 F9 30                    ; cmp ecx, '0'
	0F 85 %Eval_Immediates.next ; jne Eval_Immediates.next    # zero only counts if written as one

:Eval_Immediates.value
	E8 %express_number          ; call express_number
	89 42 18                    ; mov [edx+24], eax

:Eval_Immediates.next
	8B 12                       ; mov edx, [edx]
	85 D2                       ; test edx, edx
	0F 85 %Eval_Immediates.loop ; jne Eval_Immediates.loop
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# Preserve_Other(eax = list): anything with no expression yet stands for
# itself.  That is what carries hex2's labels and pointers through untouched.
:Preserve_Other
	50                          ; push eax
	53                          ; push ebx
	51                          ; push ecx
	52                          ; push edx
	89 C2                       ; mov edx, eax

:Preserve_Other.loop
	8B 42 08                    ; mov eax, [edx+8]
	83 F8 01                    ; cmp eax, 1
	0F 84 %Preserve_Other.next  ; je Preserve_Other.next
	8B 42 18                    ; mov eax, [edx+24]
	85 C0                       ; test eax, eax
	0F 85 %Preserve_Other.next  ; jne Preserve_Other.next
	8B 42 10                    ; mov eax, [edx+16]
	89 42 18                    ; mov [edx+24], eax           # anything left over stands for itself

:Preserve_Other.next
	8B 12                       ; mov edx, [edx]
	85 D2                       ; test edx, edx
	0F 85 %Preserve_Other.loop  ; jne Preserve_Other.loop
	5A                          ; pop edx
	59                          ; pop ecx
	5B                          ; pop ebx
	58                          ; pop eax
	C3                          ; ret

# File_Print(eax = string): write it, if it is not NULL.
:File_Print
	53                          ; push ebx
	51                          ; push ecx
	89 C3                       ; mov ebx, eax
	85 C0                       ; test eax, eax
	0F 84 %File_Print.done      ; je File_Print.done          # a NULL expression prints as nothing

:File_Print.loop
	8A 03                       ; mov al, [ebx]
	0F B6 C0                    ; movzx eax, al
	85 C0                       ; test eax, eax
	0F 84 %File_Print.done      ; je File_Print.done
	E8 %fputc                   ; call fputc
	83 C3 01                    ; add ebx, 1
	E9 %File_Print.loop         ; jmp File_Print.loop

:File_Print.done
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# Print_Hex(eax = list): write each expression on its own line.
:Print_Hex
	53                          ; push ebx
	51                          ; push ecx
	89 C3                       ; mov ebx, eax

:Print_Hex.loop
	8B 43 08                    ; mov eax, [ebx+8]
	83 F8 01                    ; cmp eax, 1
	0F 84 %Print_Hex.next       ; je Print_Hex.next           # a macro defines, it does not emit
	8B 43 18                    ; mov eax, [ebx+24]
	E8 %File_Print              ; call File_Print
	B8 0A 00 00 00              ; mov eax, 0xa                # mov eax, 10
	E8 %fputc                   ; call fputc

:Print_Hex.next
	8B 1B                       ; mov ebx, [ebx]
	85 DB                       ; test ebx, ebx
	0F 85 %Print_Hex.loop       ; jne Print_Hex.loop
	59                          ; pop ecx
	5B                          ; pop ebx
	C3                          ; ret

# Resolve the six ntdll routines, open both files, read every token, then run the
# passes in order: reverse, find macros, apply them, convert strings, convert
# immediates, preserve the rest, print.
:_start
	E8 %resolve_all             ; call resolve_all
	C7 05 &malloc_ptr &arena    ; mov dword [malloc_ptr], arena # the loader zeroed it for us
	E8 %open_argv               ; call open_argv

:_start.tokenize
	E8 %Tokenize_Line           ; call Tokenize_Line
	A1 &eof_flag                ; mov eax, [eof_flag]
	85 C0                       ; test eax, eax
	0F 84 %_start.tokenize      ; je _start.tokenize
	A1 &head                    ; mov eax, [head]
	85 C0                       ; test eax, eax
	0F 84 %_start.done          ; je _start.done              # an empty input makes an empty output
	E8 %Reverse_List            ; call Reverse_List
	A3 &head                    ; mov [head], eax
	A1 &head                    ; mov eax, [head]
	E8 %Identify_Macros         ; call Identify_Macros
	A1 &head                    ; mov eax, [head]
	E8 %Line_Macro              ; call Line_Macro
	A1 &head                    ; mov eax, [head]
	E8 %Process_String          ; call Process_String
	A1 &head                    ; mov eax, [head]
	E8 %Eval_Immediates         ; call Eval_Immediates
	A1 &head                    ; mov eax, [head]
	E8 %Preserve_Other          ; call Preserve_Other
	A1 &head                    ; mov eax, [head]
	E8 %Print_Hex               ; call Print_Hex

:_start.done
	E9 %exit_ok                 ; jmp exit_ok                 # closes both files and exits 0

## ==== .data ====

# M0's own data; the plumbing's lives in ntdll-i386.hex2.
:M0_data

:DEFINE_str
44 45 46 49 4E 45 00            # DEFINE_str = "DEFINE"

# The character sets the tokenizer splits on.
:terminators
0A 0D 09 20 00                  # terminators = "\n\r\t "

:comments
3B 23 00                        # comments = ";#"

:string_char
22 27 00                        # string_char = "\"'"

# Allocator and tokenizer state.
:malloc_ptr
00 00 00 00                     # malloc_ptr: the bump allocator's cursor

:head
00 00 00 00                     # head: the token list

:eof_flag
00 00 00 00                     # eof_flag: set once the input is exhausted

:tok_c
00 00 00 00                     # tok_c: the character Tokenize_Line is looking at

:tok_p
00 00 00 00                     # tok_p: the token being filled in

# SizeOfCode and SizeOfRawData are measured to here.
:PE_end

## ==== reserved, zero-filled by the loader (past the end of the file) ====
:arena  # 0 bytes  -- everything malloc hands out, zero-filled by the loader
