:fn_table

# Resolved routine addresses.  Kept in memory because eight will not fit in registers.
:fn_create
00 00 00 00                     # fn_create: slot 0, resolved NtCreateFile -- open a file, or make one

:fn_read
00 00 00 00                     # fn_read: slot 1, resolved NtReadFile -- read

:fn_write
00 00 00 00                     # fn_write: slot 2, resolved NtWriteFile -- write

:fn_close
00 00 00 00                     # fn_close: slot 3, resolved NtClose -- close, and any other handle

:fn_exit
00 00 00 00                     # fn_exit: slot 4, resolved NtTerminateProcess -- _exit

:fn_rtlpath
00 00 00 00                     # fn_rtlpath: slot 5, resolved RtlDosPathNameToNtPathName_U -- a DOS path becomes an NT path

:fn_setinfo
00 00 00 00                     # fn_setinfo: slot 6, resolved NtSetInformationFile -- lseek, and unlink

:fn_queryinfo
00 00 00 00                     # fn_queryinfo: slot 7, resolved NtQueryInformationFile -- lseek, and fstat

:fn_queryattr
00 00 00 00                     # fn_queryattr: slot 8, resolved NtQueryAttributesFile -- access

:fn_queryfull
00 00 00 00                     # fn_queryfull: slot 9, resolved NtQueryFullAttributesFile -- stat

:fn_setcwd
00 00 00 00                     # fn_setcwd: slot 10, resolved RtlSetCurrentDirectory_U -- chdir

:fn_getcwd
00 00 00 00                     # fn_getcwd: slot 11, resolved RtlGetCurrentDirectory_U -- getcwd

:fn_dup
00 00 00 00                     # fn_dup: slot 12, resolved NtDuplicateObject -- dup and dup2

:fn_time
00 00 00 00                     # fn_time: slot 13, resolved NtQuerySystemTime -- time, gettimeofday, clock_gettime

:fn_queryvol
00 00 00 00                     # fn_queryvol: slot 14, resolved NtQueryVolumeInformationFile -- isatty

:fn_wait
00 00 00 00                     # fn_wait: slot 15, resolved NtWaitForSingleObject -- waitpid

:fn_queryproc
00 00 00 00                     # fn_queryproc: slot 16, resolved NtQueryInformationProcess -- waitpid, for the exit status

:fn_delete
00 00 00 00                     # fn_delete: slot 17, resolved NtDeleteFile -- unlink and rmdir

:fn_version
00 00 00 00                     # fn_version: slot 18, resolved RtlGetVersion -- uname

:fn_makeparams
00 00 00 00                     # fn_makeparams: slot 19, resolved RtlCreateProcessParameters -- __spawn, for the child's parameter block

:fn_createproc
00 00 00 00                     # fn_createproc: slot 20, resolved RtlCreateUserProcess -- __spawn

:fn_resume
00 00 00 00                     # fn_resume: slot 21, resolved NtResumeThread -- __spawn: a new process starts suspended

:fn_alloc
00 00 00 00                     # fn_alloc: slot 22, resolved NtAllocateVirtualMemory -- a real brk, for a program too big to live inside the image

:fn_clone
00 00 00 00                     # fn_clone: slot 23, resolved RtlCloneUserProcess -- fork; absent on wine, where the slot stays 0

:fn_getcontext
00 00 00 00                     # fn_getcontext: slot 24, resolved NtGetContextThread -- fork: the context a suspended child would start with

:fn_setcontext
00 00 00 00                     # fn_setcontext: slot 25, resolved NtSetContextThread -- fork: point that child at where its parent was instead

:fn_writevm
00 00 00 00                     # fn_writevm: slot 26, resolved NtWriteVirtualMemory -- fork: copy this process's memory into that child

:fn_readvm
00 00 00 00                     # fn_readvm: slot 27, resolved NtReadVirtualMemory -- fork: watch for the child to say it has parked

:fn_suspend
00 00 00 00                     # fn_suspend: slot 28, resolved NtSuspendThread -- fork: stop that child before overwriting it

:fn_wow64qinfo
00 00 00 00                     # fn_wow64qinfo: slot 29, resolved NtWow64QueryInformationProcess64 -- wow64 clone fix: this process's own 64-bit PEB address

:fn_wow64readvm
00 00 00 00                     # fn_wow64readvm: slot 30, resolved NtWow64ReadVirtualMemory64 -- wow64 clone fix: read the 64-bit ntdll/wow64cpu images to resolve BTCpuSimulate

# Arguments that must survive the RtlDosPathNameToNtPathName_U call.
:g_access
00 00 00 00                     # g_access: DesiredAccess held across the RtlDosPathNameToNtPathName_U call

:g_disp
00 00 00 00                     # g_disp: CreateDisposition, same

:g_handle
00 00 00 00                     # g_handle: NtCreateFile's out-parameter

# OBJECT_ATTRIBUTES, one label per field so hex2 can address each of them.
:oa
00 00 00 00                     # oa: OBJECT_ATTRIBUTES.Length

:oa_root
00 00 00 00                     # oa_root: .RootDirectory

:oa_name
00 00 00 00                     # oa_name: .ObjectName

:oa_attr
00 00 00 00                     # oa_attr: .Attributes

:oa_sd
00 00 00 00                     # oa_sd: .SecurityDescriptor

:oa_sqos
00 00 00 00                     # oa_sqos: .SecurityQualityOfService

:nt_path
00 00 00 00 00 00 00 00         # nt_path: UNICODE_STRING filled by RtlDosPathNameToNtPathName_U

# IO_STATUS_BLOCK.  Information is the byte count of a read.
:iosb
00 00 00 00                     # iosb: IO_STATUS_BLOCK.Status

:iosb_info
00 00 00 00                     # iosb_info: IO_STATUS_BLOCK.Information

# The two open files.
:in_handle
00 00 00 00                     # in_handle: argv[1]

:out_handle
00 00 00 00                     # out_handle: argv[2]

# One-byte read and write buffers.
:inbuf
00                              # inbuf: one-byte read buffer

:outbuf
00                              # outbuf: one-byte write buffer

:__shared_end
