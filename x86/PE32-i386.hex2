#
# PE32-i386.hex2: the PE32/i386 executable header, in hex2's language.
#
# hex2 emits bytes; it knows nothing about executable formats.  This file is the
# header a Windows program needs, written so that hex2 fills in the fields that
# depend on the program:
#
#   catm prog.hex2 PE32-i386.hex2 body.hex2
#   hex2 prog.hex2 prog.exe
#
# The program must define _start and must end with :PE_end.
#
# hex2's pointers
#   !name  one byte relative    $name  two bytes absolute
#   @name  two bytes relative   &name  four bytes absolute
#   %name  four bytes relative  name>base  measured from base, not from here
#
# ip counts from the image base, so a label's value is the address it will have
# once loaded.  For that to be right, an RVA has to be the same number as a file
# offset, which is why SizeOfHeaders, the section's VirtualAddress and its
# PointerToRawData are all 0x1000: the section begins at the same place in the
# file as it does in memory, and hex2, which only counts bytes, needs nothing
# more.
#
# SectionAlignment is the page size.  The format allows less -- FileAlignment
# must then match it -- but Windows rejects such an image with
# ERROR_BAD_EXE_FORMAT, so the padding to 0x1000 below is not optional.
# SizeOfRawData, by contrast, is left exactly as long as the program is, and no
# multiple of FileAlignment, which Windows does accept.
#
# The section's VirtualSize runs to the top of the image, so everything between
# the end of the file and 0x8400000 is zero-filled writable memory.  A program
# declares a buffer by putting a label after :PE_end and never has to ask for
# memory at run time.
#
# The image imports nothing: NumberOfRvaAndSizes is 0, so there is no import
# directory.  A program reaches ntdll through the PEB instead.
#
# SizeOfStackReserve is 8MB, not the 1MB a default MSVC-linked program gets:
# found by running a self-hosted C compiler built on this bootstrap (nova-nix's
# tinycc port) far enough to compile a real source file, where 2MB -- this
# field's previous value -- overflowed partway through, walking the stack down
# from the top of its reservation to the bottom before Windows raised
# STATUS_STACK_OVERFLOW. Two things stack it deeper than a native build of the
# same compiler would: MesCC gives every function it compiles a fixed-size
# local frame rather than sizing one to what the function actually declares,
# and the ntdll-by-PEB path every syscall-shaped call takes here
# (lib/windows/ntdll.c's __ntdll_resolve, ntcall.c's __ntcallN) is itself a few
# more stack frames per call than a real syscall instruction would ever cost.
# SizeOfStackCommit is unchanged -- Windows grows the committed region on
# demand as the stack is touched, up to whatever is reserved here, so only the
# ceiling needed to move.

:PE_base

## DOS header
4D 5A                           # e_magic 'MZ'
90 00                           # e_cblp
03 00                           # e_cp
00 00                           # e_crlc
04 00                           # e_cparhdr
00 00                           # e_minalloc
FF FF                           # e_maxalloc
00 00                           # e_ss
B8 00                           # e_sp
00 00                           # e_csum
00 00                           # e_ip
00 00                           # e_cs
40 00                           # e_lfarlc
00 00                           # e_ovno
00 00 00 00 00 00 00 00         # e_res[4]
00 00                           # e_oemid
00 00                           # e_oeminfo
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 # e_res2[10]
40 00 00 00                     # e_lfanew -> the PE header at file offset 0x40 (no DOS stub program)

## COFF header
50 45 00 00                     # Signature 'PE\0\0'
4C 01                           # Machine = 0x014c (i386)
01 00                           # NumberOfSections = 1 (code and data share one section)
00 00 00 00                     # TimeDateStamp = 0: nothing here depends on when it was built
00 00 00 00                     # PointerToSymbolTable
00 00 00 00                     # NumberOfSymbols
60 00                           # SizeOfOptionalHeader = 0x60 (the PE32 optional header with no data directories)
0F 03                           # Characteristics = 0x030f (executable, 32-bit, no relocations/line numbers/symbols)

## Optional header
0B 01                           # Magic = 0x010b (PE32)
00                              # MajorLinkerVersion
00                              # MinorLinkerVersion
%PE_end>PE_text                 # SizeOfCode: everything hex2 emits after this header
00 00 00 00                     # SizeOfInitializedData
00 00 00 00                     # SizeOfUninitializedData
%_start>PE_base                 # AddressOfEntryPoint: the program defines _start
00 10 00 00                     # BaseOfCode = 0x1000
00 00 00 00                     # BaseOfData
00 00 40 00                     # ImageBase = 0x400000
00 10 00 00                     # SectionAlignment = 0x1000
00 02 00 00                     # FileAlignment = 0x200
04 00                           # MajorOperatingSystemVersion
00 00                           # MinorOperatingSystemVersion
00 00                           # MajorImageVersion
00 00                           # MinorImageVersion
04 00                           # MajorSubsystemVersion
00 00                           # MinorSubsystemVersion
00 00 00 00                     # Win32VersionValue
00 00 00 08                     # SizeOfImage = 0x8000000
00 10 00 00                     # SizeOfHeaders = 0x1000
00 00 00 00                     # CheckSum = 0, which is accepted for anything but a kernel image
03 00                           # Subsystem = 3 (console)
00 01                           # DllCharacteristics = 0x0100 (NX compatible)
00 00 80 00                     # SizeOfStackReserve = 0x800000 (8MB)
00 10 00 00                     # SizeOfStackCommit
00 00 10 00                     # SizeOfHeapReserve
00 10 00 00                     # SizeOfHeapCommit
00 00 00 00                     # LoaderFlags
00 00 00 00                     # NumberOfRvaAndSizes = 0 (no data directories, so no import table)

## Section header
2E 74 65 78 74 00 00 00         # Name = '.text'
00 F0 FF 07                     # VirtualSize = 0x7fff000
00 10 00 00                     # VirtualAddress = 0x1000
%PE_end>PE_text                 # SizeOfRawData: the rest is past the end of the file and zero-filled
00 10 00 00                     # PointerToRawData = 0x1000
00 00 00 00                     # PointerToRelocations
00 00 00 00                     # PointerToLinenumbers
00 00                           # NumberOfRelocations
00 00                           # NumberOfLinenumbers
20 00 00 E0                     # Characteristics = 0xe0000020 (code, executable, readable, writable)

## Padding to SizeOfHeaders
