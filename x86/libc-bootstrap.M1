#
# libc-bootstrap.M1: the :__libc_init that libc-core.M1's _start calls, for a
# program built against x86/M2libc-windows/bootstrap.c.
#
# There is nothing to do.  bootstrap.c has no FILE* and no free list -- its
# malloc hands out the image's own memory and never takes any back, and its
# fgetc and fputc take a handle rather than a stream -- so nothing has to be
# built before main runs.  libc-full.M1 is the other half of this choice.
:__libc_init
	ret
