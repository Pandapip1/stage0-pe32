#
# libc-core-pe32: what a compiled C program stands on, whether cc_x86 compiled
# it (M2-Planet itself, in Phase 5) or M2 did (everything after).
#
# A compiler emits calls and arithmetic and nothing else.  Everything a program
# does that is not arithmetic has to be here, or in the bootstrap.c that goes
# with this file.  catm puts the three in front of the compiled program:
#
#   catm prog-0.M1 M2libc/x86/x86_defs.M1 libc-core.M1 prog.M1
#   M0 prog-0.M1 prog-0.hex2
#   catm prog.hex2 PE32-i386.hex2 ntdll-i386.hex2 prog-0.hex2
#   hex2 prog.hex2 prog.exe
#
# ntdll-i386.hex2 is linked in as well, so this file may call into it.  What it
# adds on top is the part that is specific to C rather than to Windows:
#
#   _start            build argc and argv, call main, exit with what it returns
#   __stdhandle       0, 1 and 2 mean stdin, stdout and stderr
#   __read_byte       one byte from a FILE*, or -1
#   __write_byte      one byte to a FILE*
#   __read_block      a buffer's worth, for a C library that buffers
#   __write_block     the same, outbound
#   __lseek           move the file position, or ask where it is
#   __open, __close   a file by name
#   __exit            stop, with a status
#   __heap_start      where malloc may begin
#   __ntdll           an ntdll routine, by slot, for the C above to call
#   __stdslot         where one of the three standard handles is kept
#
# What it does not have is the one thing that differs between the two C
# libraries built on it.  M2libc's own stdio.c keeps stdin, stdout and stderr
# in globals that a function has to fill in, and bootstrap.c has no such
# notion; so _start calls :__libc_init, and which file catm puts next to this
# one decides what that is:
#
#   libc-bootstrap.M1  nothing to do, for the --bootstrap-mode stages
#   libc-full.M1       __init_malloc and __init_io, for the rest
#
# Leaving it out is not a link error -- M0 would resolve nothing and hex2 would
# fail -- but leaving out the *full* one and using the bootstrap one by mistake
# is quiet: stdout and stderr stay NULL, and the program faults the first time
# it reports an error.  That is exactly what hex2 built from C did before this
# existed.
#
# M2libc/x86/x86_defs.M1 -- the submodule's own, not a copy -- matters more
# than it looks: it is the mnemonic set M2's own code generator actually emits
# (xor_eax,eax and friends), which is wider than what cc_x86.M1's hand-written
# assembly happens to use.  A DEFINE M0 doesn't recognize isn't an error -- it
# passes the text through unchanged, which hex2 then can't make sense of
# either, and the mnemonic is silently dropped instead of assembled.  Getting
# this file wrong doesn't fail loudly; it corrupts the binary quietly.
#
# x86/M2libc-windows/bootstrap.c is the other half: it is the C these are
# reached from, and the two are meant to be read together.
#
# Upstream's x86/libc-core.M1 is nine instructions, because on Linux argc and
# argv are already on the stack and exit is a syscall.  Neither is true here.
#
# The memory past the end of the image
#
# There is no brk and nothing is ever asked of the operating system: the image
# runs to 128MB and everything past the end of the file is mapped, writable and
# already zero.  This file divides it up, measured from :PE_end, which is the
# last label the compiled program emits:
#
#   +0x00000   argv, 256 pointers
#   +0x00400   the argument strings themselves
#   +0x08000   one path, widened to UTF-16 for ntdll
#   +0x10000   the heap, which is where malloc starts
#
# Nothing checks these bounds.  A command line of more than 256 arguments or
# 31KB, or a path of more than 2048 characters, would run past its own area,
# and this is the layer below the one that could report it.


# Instructions M2libc/x86/x86_defs.M1 does not already name.  A duplicate
# DEFINE is harmless, but there is no reason to add any, so these are only the
# ones it lacks.
DEFINE add_ebx, 81C3
DEFINE add_ecx, 81C1
DEFINE add_edi, 81C7
DEFINE add_edx, 81C2
DEFINE call_[DWORD] FF15
DEFINE cmp_eax, 83F8
DEFINE jg 0F8F
DEFINE js 0F88
DEFINE mov_al,[edx] 8A02
DEFINE mov_ebp, BD
DEFINE mov_ebx,ebp 89EB
DEFINE mov_ecx, B9
DEFINE mov_edi, BF
DEFINE mov_edx,eax 89C2
DEFINE mov_esi, BE
DEFINE mov_eax,[eax+BYTE] 8B40
DEFINE mov_eax,[fs:DWORD] 64A1
DEFINE mov_eax,[esp] 8B0424
DEFINE mov_eax,[esi] 8B06
DEFINE mov_eax,esi 89F0
DEFINE mov_eax,esp 89E0
DEFINE mov_esi,[eax+BYTE] 8B70
DEFINE mov_[DWORD],eax A3
DEFINE mov_[DWORD],ebp 892D
DEFINE mov_[DWORD],ebx 891D
DEFINE mov_[DWORD],esi 8935
DEFINE mov_[DWORD],edi 893D
DEFINE mov_[DWORD],ecx 890D
DEFINE mov_eax,[DWORD] A1
DEFINE mov_ebx,[DWORD] 8B1D
DEFINE mov_[ebx],edi 893B
DEFINE mov_[edi],al 8807
DEFINE mov_[edi],BYTE C607
DEFINE movzx_eax,BYTE_PTR_[DWORD] 0FB605
DEFINE push_byte 6A
DEFINE push_ecx 51
DEFINE push_edi 57
DEFINE push_DWORD 68
DEFINE push_[DWORD] FF35
DEFINE sal_ebx, C1E3
DEFINE test_al,al 84C0
DEFINE test_ebx,ebx 85DB


# _start
# Where the PE header sends us
# Builds the argc and argv that main expects, calls it, and exits with what it
# returns
#
# cc_x86 gives a function its arguments below the frame pointer: the first at
# ebp-4, the second at ebp-8, and so on, with the return address below those
# and main's own locals below that.  So the three words pushed here, in this
# order, are what main reads as argc, argv and envp.  The environment is a
# pointer to a NULL, because nothing in this chain reads one.
:_start
	call %resolve_all                           ; Find ntdll and resolve what we need from it
	call %__libc_init                           ; Whatever the C library above wants set up

	mov_eax,[DWORD] &__fork_child_flag          ; Did a fork put us here rather than a user?
	test_eax,eax
	je %_start_main                             ; The ordinary case, and the only one that runs main

# A fork child, which must not run main and must not touch anything its parent
# is about to overwrite.  Everything above has happened -- loader init, ntdll
# resolved, the C library set up -- so the stack below is finished with and the
# parent may have it.  Say so, and spin: the parent suspends this thread, copies
# itself over this process, and points the thread at where it wants it.  Nothing
# here ever leaves this loop under its own power.
:_start_park
	mov_eax, %1
	mov_[DWORD],eax &__fork_parked
	jmp %_start_park

:_start_main

	mov_ebp, &PE_end                            ; ARGV, the array of pointers
	mov_ebx,ebp                                 ; Cursor into that array
	mov_edi, &PE_end
	add_edi, %1024                              ; STRINGS, after 256 pointer slots
	mov_ecx, %0                                 ; ARGC = 0

	mov_eax,[fs:DWORD] %0x30                    ; TEB->PEB
	mov_eax,[eax+BYTE] !16                      ; PEB->ProcessParameters
	mov_esi,[eax+BYTE] !68                      ; ->CommandLine.Buffer, the cursor next_token walks

:_start_arg
	call %next_token                            ; The next argument, in UTF-16, or NULL
	test_eax,eax                                ; Check for the end of the command line
	je %_start_args_done                        ; Then we have them all

	mov_[ebx],edi                               ; argv[argc] = where its narrow copy will go
	add_ebx, %4                                 ; Advance the array cursor
	add_ecx, %1                                 ; ARGC = ARGC + 1
	mov_edx,eax                                 ; The UTF-16 source

:_start_narrow
	mov_al,[edx]                                ; Low byte of the UTF-16 unit
	mov_[edi],al                                ; Which for ASCII is the whole character
	add_edi, %1
	add_edx, %2                                 ; UTF-16 advances two bytes at a time
	test_al,al                                  ; Check for the NUL
	jne %_start_narrow                          ; Which is copied and then ends the loop
	jmp %_start_arg                             ; On to the next argument

:_start_args_done
	mov_eax, %0
	mov_[ebx],eax                               ; argv[argc] = NULL, which main tests for

	push_ecx                                    ; argc, which main reads at ebp-4
	push_ebp                                    ; argv, at ebp-8
	push_ebx                                    ; envp, at ebp-12: the NULL just written
	mov_ebp,esp
	add_ebp, %12                                ; ebp is 4 above the argc that was pushed first
	call %FUNCTION_main

	push_eax                                    ; ExitStatus = whatever main returned
	push_byte !-1                               ; ProcessHandle = NtCurrentProcess pseudo-handle
	call_[DWORD] &fn_exit                       ; Does not return


# __stdhandle function
# Receives FILE* in EAX
# Returns a handle Windows will accept in EAX
#
# C says stdin, stdout and stderr are 0, 1 and 2.  Windows has no such numbers;
# the three handles are in the PEB, next to each other, starting at
# ProcessParameters+0x18.  Anything above 2 is already a handle -- a real one
# is never that small -- and comes back unchanged.
:__stdhandle
	cmp_eax, !2                                 ; Check for one of the three
	jg %__stdhandle_done                        ; Otherwise it is already a handle
	push_ebx                                    ; Protect EBX
	mov_ebx,eax                                 ; 0, 1 or 2
	sal_ebx, !2                                 ; Which is a word apart in the PEB
	add_ebx, %24                                ; ProcessParameters->hStdInput is at 0x18
	mov_eax,[fs:DWORD] %0x30                    ; TEB->PEB
	mov_eax,[eax+BYTE] !16                      ; PEB->ProcessParameters
	add_eax,ebx                                 ; The slot we want
	mov_eax,[eax]                               ; The handle in it
	pop_ebx                                     ; Restore EBX

:__stdhandle_done
	ret


# __read_byte function
# Receives FILE* in EAX
# Returns the byte in EAX, or -1 at end of file
#
# -1 rather than the -4 ntdll-i386.hex2's own fgetc returns, because this is
# the EOF the C in bootstrap.c compares against.
:__read_byte
	call %__stdhandle                           ; What ntdll will accept
	mov_[DWORD],eax &__handle                   ; Held while the arguments are pushed
	push_byte !0                                ; Key
	push_byte !0                                ; ByteOffset = NULL: the file keeps its own position
	push_byte !1                                ; Length = 1
	push_DWORD &inbuf                           ; Buffer
	push_DWORD &iosb                            ; IoStatusBlock
	push_byte !0                                ; ApcContext
	push_byte !0                                ; ApcRoutine
	push_byte !0                                ; Event
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_read
	test_eax,eax                                ; NTSTATUS < 0, which is how end of file arrives
	js %__read_byte_eof
	movzx_eax,BYTE_PTR_[DWORD] &inbuf           ; The byte, zero extended
	ret

:__read_byte_eof
	mov_eax, %-1                                ; EOF, as bootstrap.c spells it
	ret


# __write_byte function
# Receives FILE* in EAX and the byte in EBX
# Returns nothing
:__write_byte
	mov_[DWORD],ebx &__byte                     ; The byte gets a word of its own to be written from
	call %__stdhandle                           ; What ntdll will accept
	mov_[DWORD],eax &__handle                   ; Held while the arguments are pushed
	push_byte !0                                ; Key
	push_byte !0                                ; ByteOffset = NULL
	push_byte !1                                ; Length = 1
	push_DWORD &__byte                          ; Buffer
	push_DWORD &iosb                            ; IoStatusBlock
	push_byte !0                                ; ApcContext
	push_byte !0                                ; ApcRoutine
	push_byte !0                                ; Event
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_write
	ret


# __open function
# Receives char* name in EAX and, in EBX, nonzero to write and zero to read
# Returns a handle in EAX, or 0
#
# ntdll takes UTF-16 and nothing else, so the name is widened first.  ASCII
# widens by putting a zero after every byte; anything else in a path will not
# survive, and this is not the layer that could tell you so.
:__open
	mov_edx,eax                                 ; The narrow source
	mov_edi, &PE_end
	add_edi, %0x8000                            ; The path buffer, past the arguments
	push_edi                                    ; Where it starts, for after the loop

:__open_widen
	mov_al,[edx]
	mov_[edi],al                                ; The character
	add_edi, %1
	mov_[edi],BYTE !0                           ; And the zero above it
	add_edi, %1
	add_edx, %1
	test_al,al                                  ; Check for the NUL
	jne %__open_widen                           ; Which is widened and then ends the loop

	pop_eax                                     ; The widened path
	test_ebx,ebx                                ; Reading or writing
	jne %__open_write

	mov_ecx, %0x80100000                        ; GENERIC_READ|SYNCHRONIZE
	mov_edx, %1                                 ; FILE_OPEN: it has to be there already
	jmp %open_file                              ; Which returns the handle, or 0

:__open_write
	mov_ecx, %0x40100000                        ; GENERIC_WRITE|SYNCHRONIZE
	mov_edx, %5                                 ; FILE_OVERWRITE_IF: made or emptied
	jmp %open_file                              ; Which returns the handle, or 0


# __close function
# Receives FILE* in EAX
# Returns nothing useful
:__close
	call %__stdhandle                           ; What ntdll will accept
	push_eax                                    ; Handle
	call_[DWORD] &fn_close
	ret


# __exit function
# Receives the status in EAX
# Does NOT return
:__exit
	push_eax                                    ; ExitStatus
	push_byte !-1                               ; ProcessHandle = NtCurrentProcess pseudo-handle
	call_[DWORD] &fn_exit


# __ntdll function
# Receives a slot number in EAX
# Returns the address resolve_all put in that slot
#
# ntdll-i386.hex2 resolves each routine it needs out of ntdll's export table
# into a slot, and fn_table names the first of them.  The C above this file
# calls through the address this returns rather than through a stub written
# here for each routine, which is what the rest of the POSIX layer would
# otherwise have to be.
#
# That works because of how M2-Planet compiles a call: it saves the stack
# pointer in EBP first and restores it from there afterwards, rather than
# adding back what it pushed.  ntdll is stdcall and pops its own arguments, so
# a caller that adds back would corrupt the stack and this one cannot.  The
# arguments come out reversed -- M2-Planet pushes the first one first, and a
# stdcall callee expects the first one on top -- so the C writes them backwards
# and says so at each call.
:__ntdll
	sal_eax, !2                                 ; Four bytes to a slot
	add_eax, &fn_table                          ; The first of them
	mov_eax,[eax]                               ; The address in it
	ret


# __stdslot function
# Receives 0, 1 or 2 in EAX
# Returns the address of that standard handle in the process parameters
#
# __stdhandle reads one of the three; this gives out where it is, so that dup2
# can put a different handle there.  Redirection on Windows is exactly this:
# the three handles a child inherits are the three words this points into.
:__stdslot
	sal_eax, !2                                 ; 0, 1, 2 are a word apart
	add_eax, %24                                ; ProcessParameters->hStdInput is at 0x18
	push_ebx                                    ; Protect EBX
	mov_ebx,eax                                 ; The offset we worked out
	mov_eax,[fs:DWORD] %0x30                    ; TEB->PEB
	mov_eax,[eax+BYTE] !16                      ; PEB->ProcessParameters
	add_eax,ebx                                 ; The slot itself
	pop_ebx                                     ; Restore EBX
	ret


# __heap_start function
# Receives nothing
# Returns the first address malloc may hand out
:__heap_start
	mov_eax, &PE_end
	add_eax, %0x10000                           ; Past the arguments and the path buffer
	ret


# __teb function
# Receives nothing
# Returns this thread's TEB
#
# fs:0x18 is the TEB's pointer to itself, which is the one field of it that can
# be read without already knowing where it is.  fork wants StackBase and
# StackLimit out of it, at 0x04 and 0x08: the committed stack, which is what
# has to be copied into a child for the child to go on running where its parent
# left off.
:__teb
	mov_eax,[fs:DWORD] %0x18
	ret


# __fork_setjmp function
# Receives nothing, and must be called from fork itself and nowhere else
# Returns 0, always
#
# Not setjmp, in the end, though it started as one.  A fork child does not need
# to come back into fork -- it needs fork to have returned 0 to whoever called
# it -- and aiming at fork's caller rather than into fork's own middle is both
# simpler and the only version that works.
#
# The reason is where the stack is still standing by the time a child exists.
# Resuming into the middle of fork means resuming onto slots that fork's own
# later calls -- the spawn, the copies -- have long since reused for their own
# frames: the saved registers and the return address that were there at the
# moment of capture are gone.  fork's caller's frame is above all of that and
# is never touched.
#
# This dialect makes the caller's frame easy to name.  Every function it
# compiles begins `mov_esi,esp', so ESI is that function's locals pointer and
# points at its own return address for as long as it runs; a call from within
# it pushes ESI but does not change it.  So read from fork: [ESI] is where fork
# returns to, and ESI+4 is the stack its caller will have once it has.  A child
# started there with EAX zero is a child whose fork returned 0.
:__fork_setjmp
	mov_eax,[esi]                               ; fork's own return address
	mov_[DWORD],eax &__fork_eip
	mov_eax,esi
	add_eax, %4                                 ; and its caller's ESP once it has
	mov_[DWORD],eax &__fork_esp
	xor_eax,eax
	ret


# Where __fork_setjmp wrote those down, and how fork reads them back.
:__fork_geteip
	mov_eax,[DWORD] &__fork_eip
	ret

:__fork_getesp
	mov_eax,[DWORD] &__fork_esp
	ret

:__fork_exitaddr
	mov_eax, &__exit
	ret


# __read_block function
# Receives FILE* in EAX, buffer in EBX, count in ECX
# Returns the number of bytes actually read in EAX, or 0 at end of file
#
# __read_byte's larger sibling.  M2libc's stdio.c buffers, so it asks for a
# block at a time rather than a byte; the count actually transferred comes back
# in the IO_STATUS_BLOCK's Information field, which is why iosb_info is read
# rather than trusting the count that was asked for.
:__read_block
	mov_[DWORD],ebx &__bufptr                   ; Held while the arguments are pushed
	mov_[DWORD],ecx &__buflen
	call %__stdhandle                           ; What ntdll will accept
	mov_[DWORD],eax &__handle
	push_byte !0                                ; Key
	push_byte !0                                ; ByteOffset = NULL: the file keeps its own position
	push_[DWORD] &__buflen                      ; Length
	push_[DWORD] &__bufptr                      ; Buffer
	push_DWORD &iosb                            ; IoStatusBlock
	push_byte !0                                ; ApcContext
	push_byte !0                                ; ApcRoutine
	push_byte !0                                ; Event
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_read
	test_eax,eax                                ; NTSTATUS < 0, end of file among them
	js %__read_block_eof
	mov_eax,[DWORD] &iosb_info                  ; However much actually arrived
	ret

:__read_block_eof
	mov_eax, %0                                 ; Nothing read, which is how a caller sees the end
	ret


# __write_block function
# Receives FILE* in EAX, buffer in EBX, count in ECX
# Returns the number of bytes written in EAX
:__write_block
	mov_[DWORD],ebx &__bufptr                   ; Held while the arguments are pushed
	mov_[DWORD],ecx &__buflen
	call %__stdhandle                           ; What ntdll will accept
	mov_[DWORD],eax &__handle
	push_byte !0                                ; Key
	push_byte !0                                ; ByteOffset = NULL
	push_[DWORD] &__buflen                      ; Length
	push_[DWORD] &__bufptr                      ; Buffer
	push_DWORD &iosb                            ; IoStatusBlock
	push_byte !0                                ; ApcContext
	push_byte !0                                ; ApcRoutine
	push_byte !0                                ; Event
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_write
	test_eax,eax                                ; NTSTATUS < 0 is a failure to write
	js %__write_block_fail
	mov_eax,[DWORD] &iosb_info                  ; However much actually went out
	ret

:__write_block_fail
	mov_eax, %-1
	ret


# __lseek function
# Receives FILE* in EAX, offset in EBX, whence in ECX (0 SET, 1 CUR, 2 END)
# Returns the new position in EAX
#
# The file position lives in the I/O manager, because every file here is opened
# FILE_SYNCHRONOUS_IO_NONALERT, so moving it means asking ntdll rather than
# tracking it here.  FILE_POSITION_INFORMATION is class 14 and one LARGE_INTEGER;
# FILE_STANDARD_INFORMATION is class 5, with EndOfFile eight bytes into it.
# Only the low half of either is used: a file this chain can process is not 4GB.
:__lseek
	mov_[DWORD],ebx &__bufptr                   ; The offset, held across the calls below
	mov_[DWORD],ecx &__buflen                   ; And whence
	call %__stdhandle                           ; What ntdll will accept
	mov_[DWORD],eax &__handle

	mov_eax,[DWORD] &__buflen
	cmp_eax, !0
	je %__lseek_from_set                        ; SEEK_SET: the offset is the position
	cmp_eax, !2
	je %__lseek_from_end                        ; SEEK_END: read the size first

	; SEEK_CUR: read the position we are at, then add to it
	push_byte !14                               ; FileInformationClass = FilePositionInformation
	push_byte !8                                ; Length
	push_DWORD &__filepos                       ; FileInformation
	push_DWORD &iosb                            ; IoStatusBlock
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_queryinfo
	mov_eax,[DWORD] &__filepos
	add_eax,ebx                                 ; Where we were, plus the offset
	jmp %__lseek_set

:__lseek_from_set
	mov_eax,[DWORD] &__bufptr                   ; The offset, measured from the start
	jmp %__lseek_set

:__lseek_from_end
	push_byte !5                                ; FileInformationClass = FileStandardInformation
	push_byte !24                               ; Length
	push_DWORD &__stdinfo                       ; FileInformation
	push_DWORD &iosb                            ; IoStatusBlock
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_queryinfo
	mov_eax,[DWORD] &__stdinfo_eof              ; EndOfFile, eight bytes in
	mov_ebx,[DWORD] &__bufptr
	add_eax,ebx                                 ; The size, plus the offset

:__lseek_set
	mov_[DWORD],eax &__filepos                  ; The position we want
	mov_ebx, %0
	mov_[DWORD],ebx &__filepos_hi               ; Nothing here is past 4GB
	push_byte !14                               ; FileInformationClass = FilePositionInformation
	push_byte !8                                ; Length
	push_DWORD &__filepos                       ; FileInformation
	push_DWORD &iosb                            ; IoStatusBlock
	push_[DWORD] &__handle                      ; FileHandle
	call_[DWORD] &fn_setinfo
	mov_eax,[DWORD] &__filepos                  ; Which is where we now are
	ret


# Two words of scratch.  Nothing falls into them: every routine above ends in a
# ret or in a call that does not return, and the compiled program is only ever
# entered through a label.
:__handle
	NULL

:__byte
	NULL

:__bufptr
	NULL

:__buflen
	NULL

# FILE_POSITION_INFORMATION is one LARGE_INTEGER, and the class number for both
# NtSetInformationFile and NtQueryInformationFile is 14.
:__filepos
	NULL

:__filepos_hi
	NULL

# FILE_STANDARD_INFORMATION, class 5: AllocationSize, EndOfFile, NumberOfLinks,
# DeletePending, Directory.  Only EndOfFile is read, so the rest is just room.
:__stdinfo
	NULL

:__stdinfo_hi
	NULL

:__stdinfo_eof
	NULL

:__stdinfo_eof_hi
	NULL

:__stdinfo_rest
	NULL
	NULL

# fork's handshake with a child of its own making.  A fork child is this same
# program started again, and it has to run its own loader init -- on its own
# stack, which is at the same address as its parent's, because an image with no
# relocations gets no address-space layout randomisation and every copy of it
# is laid out identically.  So the parent cannot copy anything in until that
# init is done and out of the way.  __fork_child_flag is how it says "you are a
# fork child, do not run main"; __fork_parked is how the child says back "I am
# out of my own way now, and spinning".  See fork in M2libc-windows/process.c.
:__fork_child_flag
	NULL

:__fork_parked
	NULL

:__fork_flagaddr
	mov_eax, &__fork_child_flag
	ret

:__fork_parkedaddr
	mov_eax, &__fork_parked
	ret


# fork's three words: where __fork_setjmp's caller would have carried on, and
# the stack it would have carried on with.  Written once per fork, in the
# parent, and read back out of the copy the child was given.
:__fork_eip
	NULL

:__fork_esp
	NULL
