# catm-pe32: the Windows (PE32/i386) port of stage0's catm.
#
# catm concatenates files.  Nothing above this link has a shell, so joining a
# header to a program is a job for a program.
#
#   catm OUTPUT INPUT...
#     argv[1]        a path, created or truncated for writing
#     argv[2...]     paths, read in order and appended to it
#
# The copy buffer is 0x10000 bytes and lives past the end of the file, in the
# memory the header stub leaves zero-filled, so catm never asks for memory.
#
# This file is written in hex2's language and includes the PE32 header, because
# catm is what joins that header to everything built after it.

:PE_base

## DOS header
4D 5A                           # e_magic 'MZ'
90 00                           # e_cblp
03 00                           # e_cp
00 00                           # e_crlc
04 00                           # e_cparhdr
00 00                           # e_minalloc
FF FF                           # e_maxalloc
00 00                           # e_ss
B8 00                           # e_sp
00 00                           # e_csum
00 00                           # e_ip
00 00                           # e_cs
40 00                           # e_lfarlc
00 00                           # e_ovno
00 00 00 00 00 00 00 00         # e_res[4]
00 00                           # e_oemid
00 00                           # e_oeminfo
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 # e_res2[10]
40 00 00 00                     # e_lfanew -> the PE header at file offset 0x40 (no DOS stub program)

## COFF header
50 45 00 00                     # Signature 'PE\0\0'
4C 01                           # Machine = 0x014c (i386)
01 00                           # NumberOfSections = 1 (code and data share one section)
00 00 00 00                     # TimeDateStamp = 0: nothing here depends on when it was built
00 00 00 00                     # PointerToSymbolTable
00 00 00 00                     # NumberOfSymbols
60 00                           # SizeOfOptionalHeader = 0x60 (the PE32 optional header with no data directories)
0F 03                           # Characteristics = 0x030f (executable, 32-bit, no relocations/line numbers/symbols)

## Optional header
0B 01                           # Magic = 0x010b (PE32)
00                              # MajorLinkerVersion
00                              # MinorLinkerVersion
%PE_end>PE_text                 # SizeOfCode: everything hex2 emits after this header
00 00 00 00                     # SizeOfInitializedData
00 00 00 00                     # SizeOfUninitializedData
%_start>PE_base                 # AddressOfEntryPoint: the program defines _start
00 10 00 00                     # BaseOfCode = 0x1000
00 00 00 00                     # BaseOfData
00 00 40 00                     # ImageBase = 0x400000
00 10 00 00                     # SectionAlignment = 0x1000
00 02 00 00                     # FileAlignment = 0x200
04 00                           # MajorOperatingSystemVersion
00 00                           # MinorOperatingSystemVersion
00 00                           # MajorImageVersion
00 00                           # MinorImageVersion
04 00                           # MajorSubsystemVersion
00 00                           # MinorSubsystemVersion
00 00 00 00                     # Win32VersionValue
00 00 00 01                     # SizeOfImage = 0x1000000
00 10 00 00                     # SizeOfHeaders = 0x1000
00 00 00 00                     # CheckSum = 0, which is accepted for anything but a kernel image
03 00                           # Subsystem = 3 (console)
00 01                           # DllCharacteristics = 0x0100 (NX compatible)
00 00 20 00                     # SizeOfStackReserve
00 10 00 00                     # SizeOfStackCommit
00 00 10 00                     # SizeOfHeapReserve
00 10 00 00                     # SizeOfHeapCommit
00 00 00 00                     # LoaderFlags
00 00 00 00                     # NumberOfRvaAndSizes = 0 (no data directories, so no import table)

## Section header
2E 74 65 78 74 00 00 00         # Name = '.text'
00 F0 FF 00                     # VirtualSize = 0xfff000
00 10 00 00                     # VirtualAddress = 0x1000
%PE_end>PE_text                 # SizeOfRawData: the rest is past the end of the file and zero-filled
00 10 00 00                     # PointerToRawData = 0x1000
00 00 00 00                     # PointerToRelocations
00 00 00 00                     # PointerToLinenumbers
00 00                           # NumberOfRelocations
00 00                           # NumberOfLinenumbers
20 00 00 E0                     # Characteristics = 0xe0000020 (code, executable, readable, writable)

## Padding to SizeOfHeaders
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
