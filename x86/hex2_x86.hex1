# Conversion state.  ip is an absolute address, so a label's value is one too.
#:ip ; (0x40181C)
00 00 00 00                     # output position, an absolute address

#:toggle ; (0x401820)
FF FF FF FF

#:accum ; (0x401824)
00 00 00 00

#:cur ; (0x401828)
00 00 00 00

#:nlab ; (0x40182C)
00 00 00 00                     # number of labels recorded

#:gt_name ; (0x401830)
00 00 00 00

#:p_width ; (0x401834)
00 00 00 00                     # the pointer being emitted

#:p_abs ; (0x401838)
00 00 00 00

