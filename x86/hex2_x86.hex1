#:g_access ; (0x4017C8)
00 00 00 00

#:g_disp ; (0x4017CC)
00 00 00 00

#:g_handle ; (0x4017D0)
00 00 00 00

#:oa ; (0x4017D4)
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 # OBJECT_ATTRIBUTES

#:nt_path ; (0x4017EC)
00 00 00 00 00 00 00 00

#:iosb ; (0x4017F4)
00 00 00 00 00 00 00 00

#:filepos ; (0x4017FC)
00 00 00 00 00 00 00 00

#:in_handle ; (0x401804)
00 00 00 00

#:out_handle ; (0x401808)
00 00 00 00

#:arg_in ; (0x40180C)
00 00 00 00

#:arg_out ; (0x401810)
00 00 00 00

#:w_buf ; (0x401814)
00 00 00 00

#:w_len ; (0x401818)
