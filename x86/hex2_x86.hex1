00

#:output ; (0x40184D)
00

## ==== reserved, zero-filled by the loader (past the end of the file) ====
#:tok ; (0x40184E) 256 bytes  -- the token being read
#:tok2 ; (0x40194E) 256 bytes  -- the base label after '>'
#:names ; (0x401A4E) 4194304 bytes  -- 65536 name fields of 64 bytes
#:targets ; (0x801A4E) 262144 bytes  -- one address per name
