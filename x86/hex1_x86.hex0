	E8 B7 FC FF FF              ; call open_file
	A3 DC 15 40 00              ; mov [in_handle], eax
	A1 E8 15 40 00              ; mov eax, [arg_out]
	B9 00 00 10 40              ; mov ecx, 0x40100000         # GENERIC_WRITE|SYNCHRONIZE
