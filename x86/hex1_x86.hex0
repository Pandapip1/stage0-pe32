	E8 42 FE FF FF              ; call rewind_input
	C7 05 F4 15 40 00 00 00 00 00 ; mov dword [ip], 0x0         # the second pass recomputes it as it emits
	C7 05 F8 15 40 00 FF FF FF FF ; mov dword [toggle], -0x1
	E8 58 FE FF FF              ; call second_pass
	FF 35 E0 15 40 00           ; push dword [out_handle]
	FF 15 90 15 40 00           ; call [fn_close]
	FF 35 DC 15 40 00           ; push dword [in_handle]
	FF 15 90 15 40 00           ; call [fn_close]
	6A 00                       ; push 0x0                    # ExitStatus = 0
	6A FF                       ; push -0x1                   # ProcessHandle = NtCurrentProcess pseudo-handle
	FF 15 94 15 40 00           ; call [fn_exit]

